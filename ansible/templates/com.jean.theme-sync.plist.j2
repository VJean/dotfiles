<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jean.theme-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ ansible_facts['env'].HOME }}/.local/bin/theme-sync.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>{{ ansible_facts['env'].HOME }}/Library/Preferences/.GlobalPreferences.plist</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/theme-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/theme-sync.log</string>
</dict>
</plist>
